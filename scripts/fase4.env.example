# Copie para "fase4.env" (mesma pasta) e preencha. O fase4.env NUNCA vai para o Git.
#
# Datadog -> app.datadoghq.com > Organization Settings > API Keys > New Key
DATADOG_API_KEY=
#
# Site do Datadog (US1 = datadoghq.com, EU = datadoghq.eu, US3 = us3.datadoghq.com, US5 = us5.datadoghq.com).
# Deixe vazio para US1. O testar-integracoes.ps1 descobre o seu site e avisa.
DATADOG_SITE=
#
# PagerDuty -> Services > New Service "ToggleMaster" > Integrations > "Events API V2" > Integration Key
PAGERDUTY_ROUTING_KEY=
#
# Discord -> Canal > Editar canal > Integrações > Webhooks > Novo webhook > Copiar URL do webhook
DISCORD_WEBHOOK_URL=
#
# Senha do admin do Grafana (opcional: vazio = gera uma aleatória e mostra no final do script)
GRAFANA_ADMIN_PASSWORD=
